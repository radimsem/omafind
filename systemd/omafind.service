[Unit]
Description=omafind daemon
Documentation=https://github.com/radimsem/omafind
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=%h/.config/omarchy/plugins/radimsem.omafind/manifest.json

[Service]
Type=simple
ExecStart=%h/.local/share/omafind/venv/bin/python -m omafindd
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=1
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
