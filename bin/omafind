#!/usr/bin/env python3
import argparse
import asyncio
import importlib
import json
import os
import shutil
import socket
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PLUGIN_ROOT / "helper"))
paths = importlib.import_module("omafindd.paths")
MODEL_NAMES = ("embeddinggemma-2-Q8_0.gguf", "mmproj-embeddinggemma-2-Q8_0.gguf")
MODEL_DOWNLOAD = '''
import sys
from omafindd import models, paths

def progress(name, done, total):
    print(f"\\rmodel {name} {done}/{total} bytes", end="", flush=True)

directory = paths.model_dir()
try:
    models.download(directory, progress=progress)
    print()
    checked = models.verify(directory)
    for name, valid in checked.items():
        if not valid:
            print(f"model invalid {name}", file=sys.stderr)
    if not all(checked.values()):
        sys.exit(1)
except (OSError, ValueError) as error:
    print(str(error), file=sys.stderr)
    sys.exit(1)
print("model ready")
'''


def read_hello(path, timeout):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            deadline = time.monotonic() + timeout
            client.settimeout(timeout)
            client.connect(str(path))
            client.sendall(b'{"t":"hello","v":1}\n')
            data = b""
            while time.monotonic() < deadline:
                client.settimeout(max(0.001, deadline - time.monotonic()))
                chunk = client.recv(4096)
                if not chunk:
                    return False
                data += chunk
                while b"\n" in data:
                    line, data = data.split(b"\n", 1)
                    if len(line) > 1_048_576:
                        return False
                    try:
                        message = json.loads(line)
                    except (ValueError, UnicodeError):
                        continue
                    if (isinstance(message, dict) and message.get("t") == "state"
                            and type(message.get("v")) is int and message["v"] == 1):
                        return message
                if len(data) > 1_048_576:
                    return False
    except (OSError, ValueError):
        pass
    return False


def _socket_path(env):
    if not env.get("XDG_RUNTIME_DIR"):
        raise ValueError("XDG_RUNTIME_DIR is unset. Run omafind in a user session.")
    return Path(env["XDG_RUNTIME_DIR"]) / "omafind/ui.sock"


def _presence(env):
    # The shared path helpers create the data directory; status must only read it.
    data = Path(env.get("XDG_DATA_HOME") or Path(env["HOME"]) / ".local/share") / "omafind"
    binary = data / "runtime/bin/llama-server"
    directory = data / "model"

    def present(path):
        try:
            return path.is_file()
        except OSError:
            return False

    return {
        "runtime": {"path": str(binary),
                    "present": present(binary) and os.access(binary, os.X_OK)},
        "model": {"path": str(directory),
                  "files": {name: present(directory / name) for name in MODEL_NAMES}},
    }


def _index_status(env, run):
    from omafindd import health, permissions

    data = Path(env.get("XDG_DATA_HOME") or Path(env["HOME"]) / ".local/share") / "omafind"
    runtime = Path(env["XDG_RUNTIME_DIR"]) / "omafind" if env.get("XDG_RUNTIME_DIR") else None
    report = health.read(data / "index/health.json")
    try:
        mounted = run(["findmnt", "-rno", "UUID"], env=env,
                      capture_output=True, text=True)
        online = set(mounted.stdout.split()) if mounted.returncode == 0 else set()
    except OSError:
        online = set()
    volumes = []
    queue = 0
    for path in sorted((data / "index").glob("*.sqlite")):
        if path.name == "code.sqlite":
            continue
        label = path.stem
        files = pending = 0
        try:
            connection = sqlite3.connect(f"{path.resolve().as_uri()}?mode=ro", uri=True)
            try:
                row = connection.execute(
                    "SELECT value FROM meta WHERE key='volume_label'").fetchone()
                label = row[0] if row and row[0] else path.stem
                files, pending = connection.execute(
                    "SELECT count(indexed_at), "
                    "coalesce(sum(state='pending' OR (state='partial' AND detail IS NULL)), "
                    "0) FROM files").fetchone()
            finally:
                connection.close()
        except (OSError, sqlite3.Error):
            pass
        volumes.append({"uuid": path.stem, "label": label, "files": files,
                        "online": path.stem in online})
        queue += pending
    return {"volumes": volumes, "queue": queue,
            "permissions": permissions.check(data, runtime),
            "problems": report.get("problems", []), "recovery": report.get("recovery", {}),
            "verified": report.get("model", {}).get("verified", False)}


def _print_presence(details):
    print("runtime ready" if details["runtime"]["present"] else "runtime missing")
    files = details["model"]["files"]
    print("model ready" if all(files.values()) else "model missing")
    for name, present in files.items():
        print(f"model {name} {'ready' if present else 'missing'}")


def _command(command, env, run):
    result = run(command, env=env, capture_output=True, text=True)
    if result.returncode:
        print(result.stderr or result.stdout or f"{command[0]} failed", file=sys.stderr)
    return result.returncode == 0


def setup(env, run=subprocess.run, probe=read_hello, clock=time.monotonic, sleep=time.sleep,
          which=shutil.which):
    from omafindd.tools import check

    missing = check(which=which, run=run)
    if missing:
        print("sudo pacman -S --needed " + " ".join(missing), file=sys.stderr)
        return 1
    home = Path(env["HOME"])
    socket_path = _socket_path(env)
    if not _command(["systemctl", "--user", "show-environment"], env, run):
        return 1
    python = home / ".local/share/omafind/venv/bin/python"
    sync_env = dict(env, UV_PROJECT_ENVIRONMENT=str(python.parent.parent))
    sync = ["uv", "sync", "--project", str(PLUGIN_ROOT / "helper"), "--frozen", "--no-dev"]
    if not _command(sync, sync_env, run):
        return 1
    paths.data_dir()
    python.parent.parent.parent.chmod(0o700)
    config = Path(env.get("XDG_CONFIG_HOME") or home / ".config")
    unit = config / "systemd/user/omafind.service"
    unit.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(PLUGIN_ROOT / "systemd/omafind.service", unit)
    unit.chmod(0o644)
    if not _command(["systemctl", "--user", "daemon-reload"], env, run):
        return 1
    active = run(["systemctl", "--user", "is-active", "omafind.service"],
                 env=env, capture_output=True, text=True)
    if not _command(["systemctl", "--user", "enable", "--now", "omafind.service"], env, run):
        return 1
    if (active.returncode == 0 and active.stdout.strip() == "active"
            and not _command(["systemctl", "--user", "restart", "omafind.service"], env, run)):
        return 1
    deadline = clock() + 5
    while clock() < deadline:
        if probe(socket_path, min(0.2, max(0.001, deadline - clock()))):
            print("unit active")
            print("socket answering")
            details = _presence(env)
            _print_presence(details)
            if not details["runtime"]["present"] or not all(details["model"]["files"].values()):
                print("next bin/omafind build-runtime")
            return 0
        sleep(min(0.1, max(0, deadline - clock())))
    print("socket silent", file=sys.stderr)
    journal = run(["journalctl", "--user", "-u", "omafind.service", "-n", "20", "--no-pager"],
                  env=env, capture_output=True, text=True)
    print(journal.stdout or journal.stderr, end="", file=sys.stderr)
    return 1


def status(env, run=subprocess.run, probe=read_hello, as_json=False):
    from omafindd.tools import check

    missing = check(run=run)
    enabled_result = run(["systemctl", "--user", "is-enabled", "omafind.service"],
                         env=env, capture_output=True, text=True)
    active_result = run(["systemctl", "--user", "is-active", "omafind.service"],
                        env=env, capture_output=True, text=True)
    enabled = enabled_result.returncode == 0 and enabled_result.stdout.strip() in (
        "enabled", "enabled-runtime",
    )
    active = active_result.returncode == 0 and active_result.stdout.strip() == "active"
    path = _socket_path(env)
    answers = bool(probe(path, 0.2))
    details = {"unit": {"enabled": enabled, "active": active},
               "socket": {"path": str(path), "answers": answers},
               "tools": {"missing": missing}, **_presence(env)}
    index = _index_status(env, run)
    details["model"]["verified"] = index.pop("verified")
    details.update(index)
    if as_json:
        print(json.dumps(details, separators=(",", ":")))
    else:
        print("unit enabled" if enabled else "unit disabled")
        print("unit active" if active else "unit inactive")
        print("socket answering" if answers else "socket silent")
        _print_presence(details)
        for item in details["permissions"]:
            print(f"permission {item['path']} {item['actual']} want {item['expected']}")
        for item in details["volumes"]:
            print(f"volume {item['label']} {item['files']} "
                  f"{'online' if item['online'] else 'offline'}")
        print(f"queue {details['queue']}")
        print(f"recovery {details['recovery'].get('mode', 'none')}")
        for item in details["problems"]:
            print(f"problem {item['volume']} {item['problem']} {item['action']}")
    if missing:
        print("sudo pacman -S --needed " + " ".join(missing), file=sys.stderr)
        return 1
    if not enabled:
        return 1
    if not active:
        return 2
    return 0 if answers else 3


def build_runtime(env, run=subprocess.run, execve=os.execve):
    python = Path(env["HOME"]) / ".local/share/omafind/venv/bin/python"
    if not python.is_file():
        print("venv missing\nnext bin/omafind setup", file=sys.stderr)
        return 1
    build_env = dict(env, OMAFIND_DATA_DIR=str(paths.data_dir()))
    result = run([str(PLUGIN_ROOT / "scripts/build-runtime.sh")], env=build_env)
    if result.returncode:
        return 1
    os.chdir(PLUGIN_ROOT / "helper")
    return execve(str(python), [str(python), "-c", MODEL_DOWNLOAD], env)


def request_search(path, message, timeout=65):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(timeout)
            client.connect(str(path))
            client.sendall(b'{"t":"hello","v":1}\n' + json.dumps(message).encode() + b"\n")
            deadline = time.monotonic() + timeout
            data = b""
            while time.monotonic() < deadline:
                client.settimeout(max(.001, deadline - time.monotonic()))
                chunk = client.recv(65536)
                if not chunk:
                    break
                data += chunk
                while b"\n" in data:
                    line, data = data.split(b"\n", 1)
                    if len(line) > 1_048_576:
                        return False
                    reply = json.loads(line)
                    if isinstance(reply, dict) and reply.get("t") in ("results", "error"):
                        return reply
                if len(data) > 1_048_576:
                    return False
    except (OSError, ValueError):
        pass
    return False


def search(args, env, request):
    parser = argparse.ArgumentParser(prog="omafind search")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--limit", type=int)
    parser.add_argument("query")
    try:
        parsed = parser.parse_args(args)
    except SystemExit as error:
        return error.code
    if not parsed.query.strip() or (parsed.limit is not None and not 1 <= parsed.limit <= 200):
        print("Query must be nonempty and --limit must be 1..200", file=sys.stderr)
        return 2
    message = {"t": "search", "seq": 1, "q": parsed.query, "legs": ["words", "meaning"]}
    if parsed.limit is not None:
        message["limit"] = parsed.limit
    reply = request(_socket_path(env), message)
    if not reply:
        print("socket silent", file=sys.stderr)
        return 3
    if reply["t"] == "error":
        print(reply["reason"], file=sys.stderr)
        return 2 if reply.get("code") == "bad-request" else 1
    if parsed.json:
        print(json.dumps(reply, separators=(",", ":"), ensure_ascii=False))
    else:
        for item in reply["items"]:
            print(f"{item['path']}:{item['loc'] or ''}")
    return 0


def reindex(args, env, execve=os.execve):
    from omafindd.code import configured_roots
    from omafindd.settings import load

    parser = argparse.ArgumentParser(prog="omafind reindex")
    parser.add_argument("--root", action="append", default=[])
    parser.add_argument("--volume")
    parser.add_argument("--incremental", action="store_true")
    try:
        parsed = parser.parse_args(args)
    except SystemExit as error:
        return error.code
    settings = load(Path(env["HOME"]) / ".config/omarchy/shell.json")
    code_roots = configured_roots(lambda: settings)
    configured = {Path(root["path"]).resolve(): root for root in settings.roots}
    roots = []
    for root in parsed.root:
        path = Path(root).expanduser().resolve()
        roots.append(dict(configured.get(path, {"excludes": []}), path=str(path)))
    roots = roots or settings.roots
    if not roots and not code_roots:
        print("Choose --root PATH or configure the roots setting before omafind reindex",
              file=sys.stderr)
        return 2
    python = Path(env["HOME"]) / ".local/share/omafind/venv/bin/python"
    if Path(sys.prefix) != python.parent.parent:
        if not python.is_file():
            print("venv missing\nnext bin/omafind setup", file=sys.stderr)
            return 1
        return execve(str(python), [str(python), str(PLUGIN_ROOT / "bin/omafind"),
                                  "reindex", *args], env)
    from omafindd.embedder import Embedder, EmbeddingError, loopback_url
    from omafindd.embedding import Adapter
    from omafindd.indexing import reindex as index

    directory = Path(env.get("XDG_DATA_HOME") or Path(env["HOME"]) / ".local/share") / "omafind"
    # File text goes to this server, so only the daemon's loopback server is accepted.
    shared_url = loopback_url(env.get('OMAFIND_EMBED_URL')) if parsed.incremental else None
    embedder = Adapter(Embedder(binary=directory / "runtime/bin/llama-server",
                                model_dir=directory / "model", base_url=shared_url,
                                api_key=env.get('OMAFIND_EMBED_KEY')))
    try:
        asyncio.run(index(roots, directory=directory, embedder=embedder, volume=parsed.volume,
                          settings=settings, code_roots=code_roots, force=not parsed.incremental))
    except EmbeddingError as error:
        print(str(error), file=sys.stderr)
        return 1
    return 0


def discover(args, env, execve=os.execve):
    parser = argparse.ArgumentParser(prog="omafind discover")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--volume")
    try:
        parsed = parser.parse_args(args)
    except SystemExit as error:
        return error.code
    if not parsed.json:
        parser.print_usage(sys.stderr)
        return 2
    python = Path(env["HOME"]) / ".local/share/omafind/venv/bin/python"
    if Path(sys.prefix) != python.parent.parent:
        if not python.is_file():
            print("venv missing. Run bin/omafind setup.", file=sys.stderr)
            return 1
        return execve(str(python), [str(python), str(PLUGIN_ROOT / "bin/omafind"),
                                  "discover", *args], env)
    from omafindd.discovery import scan

    try:
        body = scan(home=Path(env["HOME"]), volume=parsed.volume).body
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(" ".join(str(error).splitlines()), file=sys.stderr)
        return 1
    print(json.dumps(body, separators=(",", ":"), ensure_ascii=False))
    return 0


def bindings(args, env, run=subprocess.run):
    from omafindd import bindings as module
    from omafindd.settings import load

    parser = argparse.ArgumentParser(prog="omafind bindings")
    parser.add_argument("action", choices=("check", "write", "remove", "menu"))
    parser.add_argument("menu_action", nargs="?", choices=("add", "remove"))
    parser.add_argument("--chord")
    try:
        parsed = parser.parse_args(args)
    except SystemExit as error:
        return error.code
    if (parsed.action == "menu") != (parsed.menu_action is not None):
        parser.print_usage(sys.stderr)
        return 2
    config = Path(env.get("XDG_CONFIG_HOME") or Path(env["HOME"]) / ".config")
    path = config / "hypr/bindings.lua"
    if parsed.action == "menu":
        menu = config / "omarchy/extensions/omarchy-menu.jsonc"
        writer = module.write_menu_row if parsed.menu_action == "add" else module.remove_menu_row
        writer(menu)
        return 0
    chord = parsed.chord or load(config / "omarchy/shell.json").shortcut
    try:
        module.parse_key(chord)
    except ValueError as error:
        print(str(error), file=sys.stderr)
        return 2
    if parsed.action == "check":
        values = module.parse_binds(path.read_text()) if path.exists() else []
        try:
            live = run(["hyprctl", "binds", "-j"], env=env, capture_output=True,
                       text=True, timeout=5)
        except FileNotFoundError:
            live = None
        if live is not None:
            if live.returncode:
                print(live.stderr or "hyprctl binds failed", file=sys.stderr)
                return 1
            values.extend(module.parse_binds(live.stdout))
        result = module.check(chord, values)
        display = " ".join(part.strip().title() if part.strip() in module.MODIFIERS
                           else part.strip() for part in chord.split("+"))
        if result == "conflict":
            holder = next(bind for bind in module.matching(chord, values) if not bind.ours)
            fallback = module.first_free(values)
            suggestion = f" Try {fallback.replace('SUPER + ', 'Super ')}." if fallback else ""
            print(f"{display} is taken by {holder.description or holder.key}.{suggestion}")
            return 2
        print(f"{display} is {'free' if result == 'free' else 'bound by omafind'}.")
        return 0
    changed = (module.write_block(path, chord) if parsed.action == "write"
               else module.remove_block(path))
    if changed:
        result = run(["hyprctl", "reload"], env=env, capture_output=True, text=True, timeout=5)
        if result.returncode:
            print(result.stderr or "Hyprland reload failed", file=sys.stderr)
            return 1
    return 0


def main(args=None, env=None, run=subprocess.run, probe=read_hello, request=request_search,
         execve=os.execve):
    args = sys.argv[1:] if args is None else args
    env = os.environ if env is None else env
    try:
        if args and args[0] == "bindings":
            return bindings(args[1:], env, run)
        if args and args[0] == "search":
            return search(args[1:], env, request)
        if args and args[0] == "discover":
            return discover(args[1:], env, execve)
        if args and args[0] == "reindex":
            return reindex(args[1:], env, execve)
        if args == ["setup"]:
            return setup(env, run, probe)
        if args == ["build-runtime"]:
            return build_runtime(env, run, execve)
        if args in (["status"], ["status", "--json"]):
            return status(env, run, probe, as_json="--json" in args)
    except (OSError, ValueError) as error:
        print(str(error), file=sys.stderr)
        return 1
    print("Usage: omafind setup | status [--json] | build-runtime | "
          "search [--json] [--limit N] QUERY | "
          "reindex [--root PATH]... [--volume UUID] [--incremental] | "
          "discover --json [--volume UUID] | "
          "bindings check|write [--chord C] | bindings remove | bindings menu add|remove",
          file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
